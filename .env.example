APP_ENV=development
DATABASE_URL=postgresql+psycopg://frontier:frontier@db:5432/frontier
PROVIDER_MODE=mock
AI_SERVICE_URL=http://ai:8100
AI_SERVICE_TIMEOUT=30
# AI internal mode is independent of the backend's mock/remote switch.
AI_PROVIDER_MODE=mock
# Relative to the backend root; point to <separate-client-root>/ai after a split.
AI_BUILD_CONTEXT=../daehwa-donghaeng-frontend/client-repo/ai
# API keys below are passed ONLY to the AI container by the integration overlay.
ANTHROPIC_API_KEY=
DATA_GO_KR_SERVICE_KEY=
